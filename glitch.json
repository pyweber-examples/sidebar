{
    "install": "pip3 install --user -r requirements.txt",
    "start": "uvicorn main:run_as_asgi --ws=websockets",
    "watch": {
      "ignore": [
        "\\.pyc$"
      ],
      "install": {
        "include": [
          "^requirements\\.txt$",
          "^\\.env$"
        ]
      },
      "restart": {
        "include": [
          "\\.py$",
          "^start\\.sh"
        ]
      },
      "throttle": 1000
    }
  }